# ---- Database (SQLite file, created by `npm run setup`) ----
DATABASE_URL="file:./dev.db"

# ---- Auth: secret used to sign session tokens (use 32+ random characters) ----
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# ---- Optional AI enhancement (OpenAI-compatible chat completions API) ----
# Leave AI_API_KEY empty to use only the built-in rule-based classifier (default).
# The AI never changes the priority; it only adds an advisory note for administrators.
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
